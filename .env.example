# Copy this file to .env and fill only the channels you use.
# .env is ignored by Git.

SLACK_WEBHOOK_AI_BRIEFINGS=
SLACK_WEBHOOK_OPS_ALERTS=
SLACK_WEBHOOK_URL=

# Telegram main command bot.
# Create a bot with BotFather, put the token here, then send /lua status Lua to the bot.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated allowlist. Leave blank for local testing only.
TELEGRAM_ALLOWED_CHAT_IDS=
